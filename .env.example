# ── Django Core ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

# ── PostgreSQL (used when DEBUG=False) ─────────────────────────
POSTGRES_USER=autolink_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=autolink_db
DATABASE_URL=postgresql://autolink_user:CHANGE_ME_STRONG_PASSWORD@postgres_db:5432/autolink_db
DB_SSL_REQUIRE=False

# ── Public site URL ───────────────────────────────────────────
SITE_URL=http://localhost:8000

# ── PayUnit / CamPay Configuration ────────────────────────────
CAMPAY_ENVIRONMENT=DEV
CAMPAY_APP_USERNAME=ton_username_fourni_par_campay
CAMPAY_APP_PASSWORD=ton_password_fourni_par_campay
CAMPAY_API_URL_DEV=https://demo.campay.net/api
CAMPAY_API_URL_PROD=https://www.campay.net/api
CAMPAY_WEBHOOK_SECRET=ta_cle_secrete_configuree_sur_le_dashboard_campay

# ── SEO ────────────────────────────────────────────────────────
# URL publique canonique : balises canonical/OpenGraph, sitemap, robots.txt.
# ⚠️ Ne pas confondre avec SITE_URL (qui peut contenir plusieurs URLs séparées
#    par des virgules pour les webhooks de paiement).
PUBLIC_SITE_URL=https://autolink.cohub.site
# Code de vérification Google Search Console (méthode « balise HTML »).
GOOGLE_SITE_VERIFICATION=
# Identifiant de mesure Google Analytics 4 (G-XXXXXXXXXX) — vide = pas de GA.
GOOGLE_ANALYTICS_ID=

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
